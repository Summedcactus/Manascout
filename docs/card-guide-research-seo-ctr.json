  "upgrades": {
    "sol-ring": {
      "name": "Sol Ring",
      "title": "Sol Ring Printings, Artwork & Versions | ManaScout",
      "description": "Compare Sol Ring’s Alpha original, Mark Tedin and Mark Poole artwork, Commander reprints, borderless editions, foils and Middle-earth collector versions.",
      "image": "https://mtg.wtf/cards_hq/cmm/410.png",
      "sources": [
        "https://mtgprices.io/set/lea/card/269-sol-ring",
        "https://mtg.wtf/card/v10/12/Sol-Ring",
        "https://mtg.wtf/card/cmd/261/Sol-Ring",
        "https://mtg.wtf/card/mps/24/Sol-Ring",
        "https://mtg.wtf/card/cmm/410/Sol-Ring",
        "https://mtg.wtf/card/cmm/703/Sol-Ring",
        "https://mtg.wtf/card/ltc/408/Sol-Ring",
        "https://mtg.wtf/card/ltc/408z/Sol-Ring",
        "https://mtg.wtf/card/ltc/410/Sol-Ring",
        "https://magic.wizards.com/en/news/feature/collecting-the-lord-of-the-rings-tales-of-middle-earth"
      ],
      "reviewed": "2026-11-10",
      "original_table_retained": true,
      "identification_paragraphs": [
        "<strong>Original Sol Ring:</strong> LEA #269 is the Alpha catalogue identity. Early cards do not print that collector number on the face; familiar Tedin artwork and a black border alone are not authentication.",
        "<strong>Familiar Commander art:</strong> CMD #261 and CMM #410 credit Mike Bierek. The former is nonfoil; the latter has nonfoil and traditional foil. V10 #12 is a separate foil-only boxed edition.",
        "<strong>“Mark Poole Sol Ring” or “full art”:</strong> check CMM #703, the borderless Poole illustration. It is neither the original Tedin image nor Bierek’s standard-frame #410, and it offers both ordinary finishes.",
        "<strong>Ornate or Tolkien-themed:</strong> MPS #24 is Baga’s foil-only Invention. LTC #408 and #410 are Quenya-language Sol Rings; a serialized #408z has its own physical serial and double-rainbow treatment. None is <a href=\"/card/the-one-ring/\">The One Ring</a>."
      ],
      "factual_corrections": []
    },
    "rhystic-study": {
      "name": "Rhystic Study",
      "title": "Rhystic Study Printings, Artwork & Foil Versions | ManaScout",
      "description": "Identify Rhystic Study’s Prophecy common, original foil, Judge and Jumpstart art, anime and confetti editions by set, artist and collector number.",
      "image": "https://mtg.wtf/cards_hq/pcy/45.png",
      "sources": [
        "https://mtg.wtf/card/pcy/45/Rhystic-Study",
        "https://mtg.wtf/card/cm1/15/Rhystic-Study",
        "https://mtg.wtf/card/j18/7/Rhystic-Study",
        "https://mtg.wtf/card/jmp/169/Rhystic-Study",
        "https://mtg.wtf/card/j22/114/Rhystic-Study",
        "https://mtg.wtf/card/wot/25/Rhystic-Study",
        "https://mtg.wtf/card/wot/71/Rhystic-Study",
        "https://mtg.wtf/card/wot/91/Rhystic-Study",
        "https://mtg.wtf/card/fca/31/Rhystic-Study"
      ],
      "reviewed": "2026-11-10",
      "original_table_retained": true,
      "identification_paragraphs": [
        "<strong>Original or original-art reprint?</strong> PCY #45 is Prophecy, with both finishes. JMP #169 reuses Nielsen’s image in nonfoil; CM1 #15 is a foil-only Commander’s Arsenal edition. The same artist does not mean the same release.",
        "<strong>Different painting?</strong> J18 #7 credits Canavan and is foil-only. J22 #114 credits Kirgetova and is nonfoil-only. Neither is simply a new frame around the Prophecy illustration.",
        "<strong>Enchanting Tales?</strong> WOT #25 is Malyon’s showcase art. #71 is Fuzichoco’s anime image in nonfoil or traditional foil; #91 is the separate confetti record using that anime art. A glittering scan is not enough to distinguish them.",
        "<strong>Final Fantasy?</strong> FCA #31 credits Square Enix and supports nonfoil/traditional foil. Its mythic rarity belongs to that later record, not the original Prophecy common."
      ],
      "factual_corrections": []
    },
    "the-one-ring": {
      "name": "The One Ring",
      "title": "The One Ring Printings, Artwork & Foil Versions | ManaScout",
      "description": "Compare The One Ring’s original, extended art, scene, scroll and poster versions. Separate surge foil, serialized editions and the unique 001/001 card.",
      "image": "https://mtg.wtf/cards_hq/ltr/246.png",
      "sources": [
        "https://mtg.wtf/card/ltr/246/The-One-Ring",
        "https://mtg.wtf/card/ltr/380/The-One-Ring",
        "https://mtg.wtf/card/ltr/451/The-One-Ring",
        "https://mtg.wtf/card/ltr/0/The-One-Ring",
        "https://www.mtg.wtf/card/ltr/697/The-One-Ring",
        "https://mtg.wtf/card/ltr/748/The-One-Ring",
        "https://mtg.wtf/card/ltr/748z/The-One-Ring",
        "https://mtg.wtf/card/ltr/791/The-One-Ring",
        "https://mtg.wtf/card/hoc/44/The-One-Ring",
        "https://mtg.wtf/card/hoc/84/The-One-Ring",
        "https://magic.wizards.com/en/banned-restricted-list"
      ],
      "reviewed": "2026-11-10",
      "original_table_retained": true,
      "identification_paragraphs": [
        "<strong>Ordinary versus expanded original art:</strong> LTR #246 is standard-frame and #380 is extended art. Both credit Nystrom and have nonfoil/foil records. “Full art” without a number does not tell you whether this is the original image or a scene/poster illustration.",
        "<strong>Scene or scroll?</strong> LTR #451 credits Marta Nael and forms part of the Mount Doom scene. Scroll #697 retains Nystrom’s credit with its own frame and silver-foil product treatment. They are not interchangeable alternate-art labels.",
        "<strong>Poster or serialized poster?</strong> #748 and #748z credit Justine Jones. The regular poster supports nonfoil/traditional foil; the serialized record is double rainbow foil. Inspect the physical serial, not just the poster artwork.",
        "<strong>The one-of-one or a later reprint?</strong> Catalogue #0 is the unique 001/001 Ring, not the later poster serial. HOC #44/#84 instead credit Dan Frazier for The Hobbit Eternal: ordinary nonfoil/foil and a separate surge-foil record."
      ],
      "factual_corrections": []
    },
    "arcane-signet": {
      "name": "Arcane Signet",
      "title": "Arcane Signet First Printing, Artwork & Versions | ManaScout",
      "description": "When was Arcane Signet first printed? Identify the 2019 Brawl original, later artwork, extended art, borderless versions and verified foil treatments.",
      "image": "https://mtg.wtf/cards_hq/eld/331.png",
      "sources": [
        "https://mtg.wtf/card/eld/331/Arcane-Signet",
        "https://www.mtg.wtf/card/cmr/297/Arcane-Signet",
        "https://mtg.wtf/card/cmr/689/Arcane-Signet",
        "https://mtg.wtf/card/sld/201/Arcane-Signet",
        "https://mtg.wtf/card/cmm/653/Arcane-Signet",
        "https://www.mtg.wtf/card/pip/752/Arcane-Signet",
        "https://mtg.wtf/card/mb2/254/Arcane-Signet",
        "https://magic.wizards.com/en/news/feature/throne-eldraine-release-notes-2019-09-20"
      ],
      "reviewed": "2026-11-10",
      "original_table_retained": true,
      "identification_paragraphs": [
        "<strong>Original release:</strong> ELD #331 is the Brawl-deck common. The set code does not mean the card was in ordinary Eldraine Draft Boosters, and there is no foil option for that exact original record.",
        "<strong>Same art, different frame:</strong> CMR #297 is the regular-frame Commander Legends reprint; #689 is extended art. Both credit Scott and support nonfoil/traditional foil.",
        "<strong>New illustration:</strong> SLD #201 credits Pendergast; CMM #653 credits Tucker. Both have nonfoil/foil choices. The borderless #653 is an artistic change, not a new finish you can apply to ELD #331.",
        "<strong>Unusual frame or reflective surface:</strong> MB2 #254 is the later foil-only Future Sight-frame record using Scott’s art. PIP #752 is Mendoza’s separate surge-foil record. A Future Sight frame does not move Arcane Signet’s debut back to 2007."
      ],
      "factual_corrections": []
    }
  },
